// Copy this file to Secrets.xcconfig (gitignored) and fill in real values.
// Secrets.xcconfig is included by project.yml's base configuration and is
// never committed — see .gitignore.
//
// The Supabase anon key is safe to ship in a client binary by design (it is
// constrained by Row Level Security on the backend), but we still keep it out
// of git so project URLs/keys can rotate per-environment (dev/staging/prod)
// without a commit.

SUPABASE_URL = https:/$()/YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY = your_anon_key_here
